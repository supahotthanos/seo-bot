<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>digital.cnai.seenai.qb-accrue</string>
  <!-- the ChatGPT lane workhorse — KeepAlive: survives crashes AND reboots (the old
       nohup-started loop died with the shell; this one is supervised) -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/supahotthanos/seo-bot/scripts/query-bank-accrue.sh</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/Users/supahotthanos/seo-bot/logs/launchd-qb-accrue.out</string>
  <key>StandardErrorPath</key><string>/Users/supahotthanos/seo-bot/logs/launchd-qb-accrue.err</string>
  <key>ProcessType</key><string>Background</string>
</dict></plist>
